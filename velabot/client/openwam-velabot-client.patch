+++ b/packages/velabot-autonomy/src/velabot/inference/protocol/openwam.py
@@ -0,0 +1,461 @@
+"""The OpenWAM MoonCake native HTTP protocol.
+
+The native front owns model preprocessing and action semantics.  This codec
+only maps the VelaBot contract to the front's fixed 20-wide wire layout:
+client camera roles become the front's camera names and gripper widths in
+metres become OpenWAM's normalized gripper values.  JPEG payloads are kept as
+opaque bytes and base64 encoded for the JSON request; the client never decodes
+or resizes them.
+"""
+
+from __future__ import annotations
+
+import base64
+import math
+from collections.abc import Mapping
+from typing import Any
+
+import numpy as np
+
+from velabot.contracts.errors import ContractViolation
+from velabot.contracts.io_schema import ArmFormat, IOSchema
+
+OPENWAM_WIRE_FORMAT = "openwam_native"
+OPENWAM_ACTION_SEMANTICS = "absolute_flange_rot6d_20d"
+OPENWAM_ACTION_DIM = 20
+OPENWAM_ACTION_HORIZON = 32
+OPENWAM_DT_SEC = 1.0 / 60.0
+OPENWAM_IMAGE_ROLES = ("head_fpv", "left_hand", "right_hand")
+OPENWAM_SERVER_IMAGE_ROLES = ("head_camera", "left_wrist_camera", "right_wrist_camera")
+OPENWAM_IMAGE_ROLE_MAP = dict(zip(OPENWAM_IMAGE_ROLES, OPENWAM_SERVER_IMAGE_ROLES, strict=True))
+OPENWAM_EFFECTOR_PROTOCOL = "agilex.parallel_gripper.width_m/v1"
+OPENWAM_EFFECTOR_CHANNEL = "opening_width"
+OPENWAM_GROUPS = ("left_arm", "right_arm")
+OPENWAM_SOURCE_REPOSITORY = "OpenWAM-Official/OpenWAM"
+OPENWAM_INTEGRATED_SOURCE_REPOSITORY = "YXGN/OpenWAM"
+OPENWAM_SOURCE_REVISION = "c171854a18a2acbeaadf46a746c4118c0e0c00f7"
+OPENWAM_INTEGRATED_BASE_REVISION = "059cbfbfc068355f3d60fe9b014ff6469d1e94a3"
+OPENWAM_ACTION_MODES = ("eef", "delta")
+_OPENWAM_MODEL_CONTRACT_BASE = {
+    "action_semantics": OPENWAM_ACTION_SEMANTICS,
+    "coordinate_frame": "body",
+    "pose_frame": "gripper_flange",
+    "position_unit": "m",
+    "rotation_representation": "rot6d_first_two_columns",
+    "gripper_unit": "width_m",
+    "native_gripper_unit": "normalized_width",
+    "native_gripper_range": [-1.0, 1.0],
+    "gripper_affine_scale": 0.05,
+    "gripper_affine_offset": 0.05,
+    "policy_hz": 60,
+}
+
+
+def model_contract_for(action_mode: str) -> dict[str, Any]:
+    """Return the fixed model contract for one trained action mode."""
+    if action_mode not in OPENWAM_ACTION_MODES:
+        raise ContractViolation(f"openwam action_mode={action_mode!r}; expected one of {OPENWAM_ACTION_MODES}")
+    contract = dict(_OPENWAM_MODEL_CONTRACT_BASE)
+    contract["action_mode"] = action_mode
+    contract["delta_xyz_addback"] = "none_for_absolute_eef" if action_mode == "eef" else "engine_once_xyz_state0"
+    return contract
+
+
+OPENWAM_MODEL_CONTRACTS = {mode: model_contract_for(mode) for mode in OPENWAM_ACTION_MODES}
+OPENWAM_MODEL_CONTRACT = OPENWAM_MODEL_CONTRACTS["eef"]
+_GRIPPER_INDEXES = (9, 19)
+
+
+class OpenWAMCodec:
+    """Strict codec for the fixed MoonCake OpenWAM native dialect."""
+
+    name = "openwam"
+    wire_format = OPENWAM_WIRE_FORMAT
+
+    def __init__(self, schema: IOSchema) -> None:
+        if len(schema.groups) != 2 or schema.include_base:
+            raise ContractViolation(
+                "openwam protocol serves exactly two arm groups and no base block; "
+                f"schema has {len(schema.groups)} groups, include_base={schema.include_base}"
+            )
+        if schema.group_names != OPENWAM_GROUPS:
+            raise ContractViolation(
+                f"openwam protocol requires groups in left-first order {OPENWAM_GROUPS}; "
+                f"schema has {schema.group_names}"
+            )
+        for spec in schema.groups:
+            if spec.arm_format is not ArmFormat.ROT6D or spec.arm_dim != 9 or spec.effector_dim != 1:
+                raise ContractViolation(
+                    "openwam protocol needs rot6d(9)+one opening_width effector per arm; "
+                    f"group {spec.group!r} is {spec.arm_format.value}({spec.arm_dim})+effector({spec.effector_dim})"
+                )
+            if spec.effector_protocol != OPENWAM_EFFECTOR_PROTOCOL:
+                raise ContractViolation(
+                    f"openwam protocol requires effector_protocol={OPENWAM_EFFECTOR_PROTOCOL!r}; "
+                    f"group {spec.group!r} declares {spec.effector_protocol!r}"
+                )
+            if spec.effector_names != (OPENWAM_EFFECTOR_CHANNEL,):
+                raise ContractViolation(
+                    f"openwam protocol requires effector channel {OPENWAM_EFFECTOR_CHANNEL!r}; "
+                    f"group {spec.group!r} declares {spec.effector_names!r}"
+                )
+            if spec.effector_position_unit != "width_m":
+                raise ContractViolation(
+                    f"openwam protocol requires effector position unit 'width_m'; "
+                    f"group {spec.group!r} declares {spec.effector_position_unit!r}"
+                )
+        if schema.action_dim != OPENWAM_ACTION_DIM:
+            raise ContractViolation(
+                f"openwam protocol requires action_dim={OPENWAM_ACTION_DIM}; schema has {schema.action_dim}"
+            )
+        self._schema = schema
+        self._handshaken = False
+        self._server_prompt: str | None = None
+        self._checkpoint = ""
+        self._identity: dict[str, Any] = {}
+
+    def encode_request(self, path: str, payload: dict[str, Any]) -> dict[str, Any]:
+        if _is_handshake(path):
+            out = dict(payload)
+            out.update(
+                {
+                    "wire_format": OPENWAM_WIRE_FORMAT,
+                    "action_dim": OPENWAM_ACTION_DIM,
+                    "action_horizon": OPENWAM_ACTION_HORIZON,
+                    "action_semantics": OPENWAM_ACTION_SEMANTICS,
+                    "dt_sec": OPENWAM_DT_SEC,
+                    "supports_rtc": False,
+                    "return_hidden": False,
+                    "image_roles": list(OPENWAM_IMAGE_ROLES),
+                }
+            )
+            return out
+        if _is_infer(path):
+            if not self._handshaken:
+                raise ContractViolation("openwam /infer requires a successful /handshake first")
+            return self._encode_infer(payload)
+        return payload
+
+    def _encode_infer(self, payload: Mapping[str, Any]) -> dict[str, Any]:
+        if payload.get("rtc") not in (None, False, {}):
+            raise ContractViolation("openwam does not support RTC")
+        if payload.get("return_hidden"):
+            raise ContractViolation("openwam does not support hidden features")
+        prompt = payload.get("prompt")
+        if not isinstance(prompt, str) or prompt != self._server_prompt:
+            raise ContractViolation("openwam prompt must match the exact training prompt from the handshake")
+        state = _finite_vector(payload.get("state"), OPENWAM_ACTION_DIM, "state")
+        images = payload.get("images")
+        if not isinstance(images, Mapping):
+            raise ContractViolation("openwam inference requires an images object")
+        unknown = sorted(set(images) - set(OPENWAM_IMAGE_ROLES))
+        missing = [role for role in OPENWAM_IMAGE_ROLES if role not in images]
+        if unknown:
+            raise ContractViolation(f"openwam client image roles are exactly {OPENWAM_IMAGE_ROLES}; got {unknown}")
+        if missing:
+            raise ContractViolation(f"openwam inference is missing image roles: {', '.join(missing)}")
+        encoded: dict[str, str] = {}
+        for client_role in OPENWAM_IMAGE_ROLES:
+            raw = images[client_role]
+            if not isinstance(raw, (bytes, bytearray)) or not raw:
+                raise ContractViolation(f"openwam image {client_role!r} must be non-empty JPEG bytes")
+            encoded[OPENWAM_IMAGE_ROLE_MAP[client_role]] = base64.b64encode(bytes(raw)).decode("ascii")
+        for index in _GRIPPER_INDEXES:
+            # No clip is intentional: silently changing a requested width would
+            # hide a contract error at the model boundary.
+            state[index] = 2.0 * state[index] / 0.1 - 1.0
+        return {
+            "type": "observation",
+            "wire_format": OPENWAM_WIRE_FORMAT,
+            "action_dim": OPENWAM_ACTION_DIM,
+            "action_semantics": OPENWAM_ACTION_SEMANTICS,
+            "state": state.tolist(),
+            "images": encoded,
+            "prompt": prompt,
+        }
+
+    def decode_response(self, path: str, response: dict[str, Any]) -> dict[str, Any]:
+        if not isinstance(response, Mapping):
+            raise ContractViolation(f"openwam response must be a JSON object, got {type(response).__name__}")
+        if response.get("ok") is False:
+            message = str(response.get("message") or response.get("error") or "no reason given")
+            raise ContractViolation(f"openwam server rejected the request: {message}")
+        if _is_handshake(path):
+            self._validate_handshake(response)
+            identity = _identity_from(response)
+            if self._handshaken and (identity != self._identity or response.get("prompt") != self._server_prompt):
+                raise ContractViolation("openwam handshake model identity changed after previous handshake")
+            self._handshaken = True
+            self._server_prompt = response["prompt"]
+            self._checkpoint = response["checkpoint"]
+            self._identity = identity
+            return dict(response)
+        if _is_infer(path):
+            if not self._handshaken:
+                raise ContractViolation("openwam /infer requires a successful /handshake first")
+            return self._decode_infer(response)
+        return dict(response)
+
+    def _validate_handshake(self, response: Mapping[str, Any]) -> None:
+        _require_equal(response, "wire_format", OPENWAM_WIRE_FORMAT, "openwam handshake")
+        _require_equal(response, "action_dim", OPENWAM_ACTION_DIM, "openwam handshake")
+        _require_equal(response, "action_horizon", OPENWAM_ACTION_HORIZON, "openwam handshake")
+        _require_equal(response, "action_semantics", OPENWAM_ACTION_SEMANTICS, "openwam handshake")
+        dt = response.get("dt_sec")
+        if (
+            isinstance(dt, bool)
+            or not isinstance(dt, (int, float))
+            or not math.isclose(float(dt), OPENWAM_DT_SEC, rel_tol=0.0, abs_tol=1e-12)
+        ):
+            raise ContractViolation(f"openwam handshake dt_sec={dt!r}; expected {OPENWAM_DT_SEC}")
+        if "dt" in response:
+            legacy_dt = response.get("dt")
+            if (
+                isinstance(legacy_dt, bool)
+                or not isinstance(legacy_dt, (int, float))
+                or not math.isfinite(float(legacy_dt))
+                or not math.isclose(float(legacy_dt), OPENWAM_DT_SEC, rel_tol=0.0, abs_tol=1e-12)
+            ):
+                raise ContractViolation(f"openwam handshake dt={legacy_dt!r} conflicts with dt_sec={OPENWAM_DT_SEC}")
+        _require_equal(response, "supports_rtc", False, "openwam handshake")
+        _require_equal(response, "return_hidden", False, "openwam handshake")
+        roles = response.get("image_roles")
+        if not isinstance(roles, list) or tuple(roles) != OPENWAM_IMAGE_ROLES:
+            raise ContractViolation(f"openwam handshake image_roles={roles!r}; expected {OPENWAM_IMAGE_ROLES}")
+        prompt = response.get("prompt")
+        if not isinstance(prompt, str) or not prompt:
+            raise ContractViolation("openwam handshake prompt must be a non-empty exact training string")
+        checkpoint = response.get("checkpoint")
+        if not isinstance(checkpoint, str) or not checkpoint:
+            raise ContractViolation("openwam handshake checkpoint must be a non-empty string")
+        advertised = response.get("io_schema")
+        if not isinstance(advertised, Mapping):
+            raise ContractViolation("openwam handshake lacks a complete velabot.io/v2 io_schema")
+        self._schema.require_wire_match(advertised, source="openwam handshake")
+        action_mode = response.get("action_mode")
+        if action_mode not in OPENWAM_ACTION_MODES:
+            raise ContractViolation(
+                f"openwam handshake action_mode={action_mode!r}; expected one of {OPENWAM_ACTION_MODES}"
+            )
+        advertised_contract = response.get("model_contract")
+        if isinstance(advertised_contract, Mapping) and advertised_contract.get("action_mode") != action_mode:
+            raise ContractViolation("openwam handshake model_contract action_mode disagrees with identity action_mode")
+        identity = _identity_from(response)
+        if identity["action_mode"] != action_mode:
+            raise ContractViolation("openwam handshake top-level action_mode disagrees with model identity")
+        expected_contract = OPENWAM_MODEL_CONTRACTS[action_mode]
+        if identity["model_contract"] != expected_contract:
+            raise ContractViolation(
+                f"openwam handshake model_contract={identity['model_contract']!r}; expected {expected_contract!r}"
+            )
+
+    def _decode_infer(self, response: Mapping[str, Any]) -> dict[str, Any]:
+        for key, expected in (
+            ("wire_format", OPENWAM_WIRE_FORMAT),
+            ("action_dim", OPENWAM_ACTION_DIM),
+            ("action_horizon", OPENWAM_ACTION_HORIZON),
+            ("action_semantics", OPENWAM_ACTION_SEMANTICS),
+        ):
+            _require_equal(response, key, expected, "openwam response")
+        dt = response.get("dt_sec")
+        if (
+            isinstance(dt, bool)
+            or not isinstance(dt, (int, float))
+            or not math.isfinite(float(dt))
+            or not math.isclose(float(dt), OPENWAM_DT_SEC, rel_tol=0.0, abs_tol=1e-12)
+        ):
+            raise ContractViolation(f"openwam response dt_sec={dt!r}; expected {OPENWAM_DT_SEC}")
+        if "dt" in response:
+            legacy_dt = response.get("dt")
+            if (
+                isinstance(legacy_dt, bool)
+                or not isinstance(legacy_dt, (int, float))
+                or not math.isfinite(float(legacy_dt))
+                or not math.isclose(float(legacy_dt), OPENWAM_DT_SEC, rel_tol=0.0, abs_tol=1e-12)
+            ):
+                raise ContractViolation(f"openwam response dt={legacy_dt!r} conflicts with dt_sec={OPENWAM_DT_SEC}")
+        checkpoint = response.get("checkpoint")
+        if not isinstance(checkpoint, str) or not checkpoint:
+            raise ContractViolation("openwam response checkpoint must be a non-empty string")
+        if checkpoint != self._checkpoint:
+            raise ContractViolation(
+                f"openwam response checkpoint={checkpoint!r}; expected negotiated {self._checkpoint!r}"
+            )
+        if _identity_from(response) != self._identity:
+            raise ContractViolation("openwam response model identity changed after handshake")
+        actions = _finite_matrix(response.get("actions"), OPENWAM_ACTION_HORIZON, OPENWAM_ACTION_DIM, "actions")
+        for index in _GRIPPER_INDEXES:
+            actions[:, index] = 0.05 * (actions[:, index] + 1.0)
+        out = dict(response)
+        out["actions"] = actions.tolist()
+        return out
+
+
+def _is_handshake(path: str) -> bool:
+    return path.rstrip("/").endswith("handshake")
+
+
+def _is_infer(path: str) -> bool:
+    return path.rstrip("/").endswith("infer")
+
+
+def _require_equal(response: Mapping[str, Any], key: str, expected: Any, label: str) -> None:
+    actual = response.get(key)
+    if isinstance(expected, bool):
+        mismatch = not isinstance(actual, bool) or actual is not expected
+    elif isinstance(expected, int):
+        mismatch = isinstance(actual, bool) or not isinstance(actual, int) or actual != expected
+    else:
+        mismatch = actual != expected
+    if mismatch:
+        raise ContractViolation(f"{label} {key}={actual!r}; expected {expected!r}")
+
+
+def _identity_from(response: Mapping[str, Any]) -> dict[str, Any]:
+    """Read the service-owned model identity and reject incomplete claims."""
+    identity: dict[str, Any] = {}
+    for key in ("checkpoint", "config", "stats"):
+        value = response.get(key)
+        if not isinstance(value, str) or not value.strip():
+            raise ContractViolation(f"openwam identity {key} must be a non-empty string")
+        identity[key] = value
+    for key in ("checkpoint_sha256", "config_sha256", "stats_sha256"):
+        value = response.get(key)
+        if (
+            not isinstance(value, str)
+            or len(value) != 64
+            or value != value.lower()
+            or any(char not in "0123456789abcdef" for char in value)
+        ):
+            raise ContractViolation(f"openwam identity {key} must be a lowercase SHA-256 hex digest")
+        identity[key] = value
+    source = response.get("source")
+    if not isinstance(source, Mapping):
+        raise ContractViolation("openwam identity source must be an object")
+    unknown_source = sorted(set(source) - {"repository", "base_revision", "revision", "patch_sha256", "files_sha256"})
+    if unknown_source:
+        raise ContractViolation(f"openwam identity source has unknown fields: {unknown_source}")
+    repository = source.get("repository")
+    if repository not in (OPENWAM_SOURCE_REPOSITORY, OPENWAM_INTEGRATED_SOURCE_REPOSITORY):
+        raise ContractViolation(
+            f"openwam identity source.repository={repository!r}; expected a supported OpenWAM repository"
+        )
+    integrated = "base_revision" in source
+    base_revision = source.get("base_revision")
+    if not integrated:
+        if repository != OPENWAM_SOURCE_REPOSITORY or source.get("revision") != OPENWAM_SOURCE_REVISION:
+            raise ContractViolation(
+                f"openwam identity source.revision must be {OPENWAM_SOURCE_REVISION} for legacy source"
+            )
+    else:
+        if repository != OPENWAM_INTEGRATED_SOURCE_REPOSITORY:
+            raise ContractViolation("openwam integrated source requires repository YXGN/OpenWAM")
+        if base_revision != OPENWAM_INTEGRATED_BASE_REVISION:
+            raise ContractViolation(
+                f"openwam identity source.base_revision={base_revision!r}; "
+                f"expected {OPENWAM_INTEGRATED_BASE_REVISION!r}"
+            )
+        revision = source.get("revision")
+        if (
+            not isinstance(revision, str)
+            or len(revision) != 40
+            or revision != revision.lower()
+            or any(char not in "0123456789abcdef" for char in revision)
+        ):
+            raise ContractViolation("openwam integrated source.revision must be a lowercase 40-hex commit")
+    if "patch_sha256" not in source or "files_sha256" not in source:
+        raise ContractViolation("openwam identity source requires patch_sha256 and files_sha256")
+    patch_sha256 = source.get("patch_sha256")
+    if patch_sha256 is not None and (
+        not isinstance(patch_sha256, str)
+        or len(patch_sha256) != 64
+        or patch_sha256 != patch_sha256.lower()
+        or any(char not in "0123456789abcdef" for char in patch_sha256)
+    ):
+        raise ContractViolation("openwam identity source.patch_sha256 must be null or lowercase SHA-256 hex")
+    files_sha256 = source.get("files_sha256", {})
+    if not isinstance(files_sha256, Mapping):
+        raise ContractViolation("openwam identity source.files_sha256 must be an object")
+    normalized_files: dict[str, str] = {}
+    for path, digest in files_sha256.items():
+        if (
+            not isinstance(path, str)
+            or not path
+            or path.startswith("/")
+            or ".." in path.split("/")
+            or not isinstance(digest, str)
+            or len(digest) != 64
+            or digest != digest.lower()
+            or any(char not in "0123456789abcdef" for char in digest)
+        ):
+            raise ContractViolation("openwam identity source.files_sha256 has an invalid relative path or digest")
+        normalized_files[path] = digest
+    if response.get("action_mode") == "delta" and (patch_sha256 is None or not normalized_files):
+        raise ContractViolation("openwam delta identity requires a non-empty applied patch fingerprint")
+    if integrated and (patch_sha256 is None or not normalized_files):
+        raise ContractViolation("openwam integrated identity requires a non-empty patch/files fingerprint")
+    identity["source"] = {
+        "repository": source["repository"],
+        "revision": source["revision"],
+        "patch_sha256": patch_sha256,
+        "files_sha256": normalized_files,
+    }
+    if integrated:
+        identity["source"]["base_revision"] = base_revision
+    contract = response.get("model_contract")
+    if not isinstance(contract, Mapping):
+        raise ContractViolation("openwam identity model_contract must be an object")
+    identity["model_contract"] = dict(contract)
+    action_mode = response.get("action_mode")
+    if action_mode not in OPENWAM_ACTION_MODES:
+        raise ContractViolation(f"openwam identity action_mode={action_mode!r}; expected one of {OPENWAM_ACTION_MODES}")
+    identity["action_mode"] = action_mode
+    return identity
+
+
+def _finite_vector(value: Any, width: int, label: str) -> np.ndarray:
+    if not isinstance(value, (list, tuple)) or len(value) != width:
+        got = len(value) if isinstance(value, (list, tuple)) else type(value).__name__
+        raise ContractViolation(f"{label} must have width {width}; got {got}")
+    if any(isinstance(item, bool) or not isinstance(item, (int, float)) for item in value):
+        raise ContractViolation(f"{label} must contain only numbers")
+    result = np.asarray(value, dtype=float)
+    if not np.all(np.isfinite(result)):
+        raise ContractViolation(f"{label} contains NaN or Inf")
+    return result
+
+
+def _finite_matrix(value: Any, rows: int, columns: int, label: str) -> np.ndarray:
+    if not isinstance(value, list) or len(value) != rows:
+        got = len(value) if isinstance(value, list) else type(value).__name__
+        raise ContractViolation(f"{label} must have shape ({rows}, {columns}); got {got}")
+    for row in value:
+        if not isinstance(row, list) or len(row) != columns:
+            raise ContractViolation(f"{label} must have shape ({rows}, {columns})")
+        if any(isinstance(item, bool) or not isinstance(item, (int, float)) for item in row):
+            raise ContractViolation(f"{label} must contain only numbers")
+    result = np.asarray(value, dtype=float)
+    if not np.all(np.isfinite(result)):
+        raise ContractViolation(f"{label} contains NaN or Inf")
+    return result
+
+
+__all__ = [
+    "OPENWAM_ACTION_DIM",
+    "OPENWAM_ACTION_HORIZON",
+    "OPENWAM_ACTION_SEMANTICS",
+    "OPENWAM_DT_SEC",
+    "OPENWAM_EFFECTOR_CHANNEL",
+    "OPENWAM_EFFECTOR_PROTOCOL",
+    "OPENWAM_GROUPS",
+    "OPENWAM_IMAGE_ROLES",
+    "OPENWAM_IMAGE_ROLE_MAP",
+    "OPENWAM_INTEGRATED_BASE_REVISION",
+    "OPENWAM_INTEGRATED_SOURCE_REPOSITORY",
+    "OPENWAM_MODEL_CONTRACT",
+    "OPENWAM_SERVER_IMAGE_ROLES",
+    "OPENWAM_SOURCE_REPOSITORY",
+    "OPENWAM_SOURCE_REVISION",
+    "OPENWAM_WIRE_FORMAT",
+    "OpenWAMCodec",
+]
diff --git a/packages/velabot-autonomy/tests/test_openwam_protocol.py b/packages/velabot-autonomy/tests/test_openwam_protocol.py
new file mode 100644
index 00000000..7b48b0bf
--- /dev/null
+++ b/packages/velabot-autonomy/tests/test_openwam_protocol.py
@@ -0,0 +1,295 @@
+"""The OpenWAM MoonCake native protocol is closed and unit preserving."""
+
+from __future__ import annotations
+
+import base64
+
+import numpy as np
+import pytest
+from test_action_format import dual_arm_descriptor
+
+from velabot.contracts.errors import ContractViolation
+from velabot.contracts.io_schema import ArmFormat, IOSchema
+from velabot.inference.protocol import (
+    OPENWAM_ACTION_HORIZON,
+    OPENWAM_ACTION_SEMANTICS,
+    OPENWAM_DT_SEC,
+    OPENWAM_IMAGE_ROLES,
+    OPENWAM_INTEGRATED_BASE_REVISION,
+    OPENWAM_INTEGRATED_SOURCE_REPOSITORY,
+    OPENWAM_MODEL_CONTRACTS,
+    OPENWAM_SOURCE_REPOSITORY,
+    OPENWAM_SOURCE_REVISION,
+    OpenWAMCodec,
+    codec_names,
+)
+
+
+def schema() -> IOSchema:
+    descriptor = dual_arm_descriptor()
+    for group in descriptor.arm_groups:
+        # The generic test descriptor uses a test protocol. OpenWAM accepts
+        # only the verified AgileX width channel.
+        effector = group.end_effector
+        object.__setattr__(effector, "protocol_key", "agilex.parallel_gripper.width_m/v1")
+        object.__setattr__(effector, "joint_names", ("opening_width",))
+    return IOSchema.from_descriptor(descriptor, arm_format=ArmFormat.ROT6D)
+
+
+def handshake(codec: OpenWAMCodec) -> dict:
+    request = codec.encode_request("/handshake", {"type": "handshake", "io_schema": schema().to_wire_dict()})
+    assert request["wire_format"] == "openwam_native"
+    assert request["image_roles"] == list(OPENWAM_IMAGE_ROLES)
+    response = {
+        "type": "handshake_ack",
+        "ok": True,
+        "backend": "openwam",
+        "wire_format": "openwam_native",
+        "action_dim": 20,
+        "action_horizon": OPENWAM_ACTION_HORIZON,
+        "action_semantics": OPENWAM_ACTION_SEMANTICS,
+        "supports_rtc": False,
+        "return_hidden": False,
+        "dt_sec": OPENWAM_DT_SEC,
+        "image_roles": list(OPENWAM_IMAGE_ROLES),
+        "prompt": "pick up the mooncake",
+        "io_schema": schema().to_wire_dict(),
+        **identity(),
+    }
+    codec.decode_response("/handshake", response)
+    return response
+
+
+def test_native_request_maps_roles_and_gripper_without_touching_jpeg_bytes():
+    codec = OpenWAMCodec(schema())
+    response = handshake(codec)
+    raw = {role: (role.encode() + b"\xff\x00") for role in OPENWAM_IMAGE_ROLES}
+    state = [0.0] * 20
+    state[9] = 0.05
+    state[19] = 0.15
+    request = codec.encode_request("/infer", {"state": state, "images": raw, "prompt": response["prompt"]})
+    assert set(request["images"]) == {"head_camera", "left_wrist_camera", "right_wrist_camera"}
+    for role, original in raw.items():
+        assert base64.b64decode(request["images"][_server_role(role)]) == original
+    assert request["state"][9] == pytest.approx(0.0)
+    assert request["state"][19] == pytest.approx(2.0)
+
+
+def _server_role(client_role: str) -> str:
+    return {
+        "head_fpv": "head_camera",
+        "left_hand": "left_wrist_camera",
+        "right_hand": "right_wrist_camera",
+    }[client_role]
+
+
+def identity(action_mode: str = "eef", *, integrated: bool = False) -> dict:
+    source = {
+        "repository": OPENWAM_SOURCE_REPOSITORY,
+        "revision": OPENWAM_SOURCE_REVISION,
+        "patch_sha256": None,
+        "files_sha256": {},
+    }
+    if action_mode == "delta":
+        source.update(patch_sha256="a" * 64, files_sha256={"openwam/deploy/engine.py": "b" * 64})
+    if integrated:
+        source = {
+            "repository": OPENWAM_INTEGRATED_SOURCE_REPOSITORY,
+            "base_revision": OPENWAM_INTEGRATED_BASE_REVISION,
+            "revision": "c" * 40,
+            "patch_sha256": "d" * 64,
+            "files_sha256": {
+                "core/openwam/deploy/engine.py": "e" * 64,
+                "velabot/client/openwam.py": "f" * 64,
+            },
+        }
+    return {
+        "checkpoint": "checkpoint_step_3000.safetensors",
+        "config": "config.yaml",
+        "stats": "normalization_stats.npy",
+        "checkpoint_sha256": "a" * 64,
+        "config_sha256": "b" * 64,
+        "stats_sha256": "c" * 64,
+        "action_mode": action_mode,
+        "source": source,
+        "model_contract": dict(OPENWAM_MODEL_CONTRACTS[action_mode]),
+    }
+
+
+def test_native_response_is_exactly_h32_and_converts_only_grippers():
+    codec = OpenWAMCodec(schema())
+    handshake(codec)
+    actions = np.zeros((32, 20), dtype=float).tolist()
+    actions[0][9] = -1.0
+    actions[0][19] = 1.0
+    decoded = codec.decode_response(
+        "/infer",
+        {
+            "actions": actions,
+            "action_dim": 20,
+            "action_horizon": 32,
+            "wire_format": "openwam_native",
+            "action_semantics": OPENWAM_ACTION_SEMANTICS,
+            "dt_sec": OPENWAM_DT_SEC,
+            **identity(),
+        },
+    )
+    values = np.asarray(decoded["actions"])
+    assert values.shape == (32, 20)
+    assert values[0, 9] == pytest.approx(0.0)
+    assert values[0, 19] == pytest.approx(0.1)
+
+
+def test_delta_model_identity_is_accepted_while_wire_semantics_stay_absolute():
+    codec = OpenWAMCodec(schema())
+    reply = handshake_reply()
+    reply.update(identity("delta"))
+    codec.decode_response("/handshake", reply)
+    assert reply["action_mode"] == "delta"
+    assert reply["action_semantics"] == OPENWAM_ACTION_SEMANTICS
+
+
+def test_integrated_model_identity_accepts_pinned_base_and_fork_revision():
+    codec = OpenWAMCodec(schema())
+    reply = handshake_reply()
+    reply.update(identity(integrated=True))
+    codec.decode_response("/handshake", reply)
+    assert reply["source"]["repository"] == OPENWAM_INTEGRATED_SOURCE_REPOSITORY
+    assert reply["source"]["base_revision"] == OPENWAM_INTEGRATED_BASE_REVISION
+
+
+@pytest.mark.parametrize(
+    "mutate, message",
+    [
+        (lambda reply: reply["source"].update(base_revision="wrong"), "base_revision"),
+        (lambda reply: reply["source"].update(base_revision=None), "base_revision"),
+        (lambda reply: reply["source"].update(repository=OPENWAM_SOURCE_REPOSITORY), "integrated source"),
+        (lambda reply: reply["source"].update(revision="short"), "40-hex"),
+        (lambda reply: reply["source"].update(patch_sha256=None), "non-empty patch/files"),
+    ],
+)
+def test_integrated_model_identity_rejects_unpinned_or_incomplete_source(mutate, message):
+    codec = OpenWAMCodec(schema())
+    reply = handshake_reply()
+    reply.update(identity(integrated=True))
+    mutate(reply)
+    with pytest.raises(ContractViolation, match=message):
+        codec.decode_response("/handshake", reply)
+
+
+@pytest.mark.parametrize(
+    "mutate, message",
+    [
+        (lambda reply: reply.update(wire_format="pose20"), "wire_format"),
+        (lambda reply: reply.update(action_semantics="xyz_delta20"), "action_semantics"),
+        (lambda reply: reply.update(dt_sec=0.05), "dt_sec"),
+        (lambda reply: reply.update(dt=0.05), "dt=.*conflicts"),
+        (lambda reply: reply.update(supports_rtc=0), "supports_rtc"),
+        (lambda reply: reply.update(image_roles=["head_fpv"]), "image_roles"),
+        (lambda reply: reply.update(io_schema={"version": "velabot.io/v2"}), "io_schema"),
+        (lambda reply: reply.update(supports_rtc=True), "supports_rtc"),
+        (lambda reply: reply.update(action_mode="delta"), "action_mode"),
+        (
+            lambda reply: reply.update(
+                source={
+                    "repository": OPENWAM_SOURCE_REPOSITORY,
+                    "revision": "wrong",
+                    "patch_sha256": None,
+                    "files_sha256": {},
+                }
+            ),
+            "source.revision",
+        ),
+        (lambda reply: reply.update(model_contract={"pose_frame": "tcp"}), "model_contract"),
+    ],
+)
+def test_handshake_refuses_dialect_capability_or_schema_mismatch(mutate, message):
+    codec = OpenWAMCodec(schema())
+    reply = handshake_reply()
+    mutate(reply)
+    with pytest.raises(ContractViolation, match=message):
+        codec.decode_response("/handshake", reply)
+
+
+def handshake_reply() -> dict:
+    codec = OpenWAMCodec(schema())
+    request = {"type": "handshake", "io_schema": schema().to_wire_dict()}
+    # Build the canonical response without changing codec state.
+    codec.encode_request("/handshake", request)
+    return {
+        "type": "handshake_ack",
+        "ok": True,
+        "wire_format": "openwam_native",
+        "action_dim": 20,
+        "action_horizon": 32,
+        "action_semantics": OPENWAM_ACTION_SEMANTICS,
+        "supports_rtc": False,
+        "return_hidden": False,
+        "dt_sec": OPENWAM_DT_SEC,
+        "image_roles": list(OPENWAM_IMAGE_ROLES),
+        "prompt": "task",
+        "io_schema": schema().to_wire_dict(),
+        **identity(),
+    }
+
+
+def test_unhandshaken_rtc_hidden_prompt_images_and_shapes_are_refused():
+    codec = OpenWAMCodec(schema())
+    with pytest.raises(ContractViolation, match="handshake"):
+        codec.encode_request("/infer", {"state": [0.0] * 20})
+    prompt = handshake(codec)["prompt"]
+    with pytest.raises(ContractViolation, match="RTC"):
+        codec.encode_request("/infer", {"state": [0.0] * 20, "images": {}, "prompt": prompt, "rtc": {"s": 1}})
+    with pytest.raises(ContractViolation, match="hidden"):
+        codec.encode_request("/infer", {"state": [0.0] * 20, "images": {}, "prompt": prompt, "return_hidden": True})
+    with pytest.raises(ContractViolation, match="missing image"):
+        codec.encode_request("/infer", {"state": [0.0] * 20, "images": {}, "prompt": prompt})
+    bad_actions = [[0.0] * 20] * 31
+    with pytest.raises(ContractViolation, match="shape"):
+        codec.decode_response(
+            "/infer",
+            {
+                "actions": bad_actions,
+                "action_dim": 20,
+                "action_horizon": 32,
+                "wire_format": "openwam_native",
+                "action_semantics": OPENWAM_ACTION_SEMANTICS,
+                "dt_sec": OPENWAM_DT_SEC,
+                **identity(),
+            },
+        )
+
+
+def test_infer_refuses_a_changed_frozen_model_identity():
+    codec = OpenWAMCodec(schema())
+    handshake(codec)
+    identity_changed = identity()
+    identity_changed["config_sha256"] = "d" * 64
+    with pytest.raises(ContractViolation, match="model identity changed"):
+        codec.decode_response(
+            "/infer",
+            {
+                "actions": [[0.0] * 20] * 32,
+                "action_dim": 20,
+                "action_horizon": 32,
+                "wire_format": "openwam_native",
+                "action_semantics": OPENWAM_ACTION_SEMANTICS,
+                "dt_sec": OPENWAM_DT_SEC,
+                **identity_changed,
+            },
+        )
+
+
+def test_rehandshake_refuses_a_changed_frozen_model_identity():
+    codec = OpenWAMCodec(schema())
+    handshake(codec)
+    changed = handshake_reply()
+    changed["stats_sha256"] = "d" * 64
+    with pytest.raises(ContractViolation, match="model identity changed"):
+        codec.decode_response("/handshake", changed)
+
+
+def test_registry_and_wrong_schema_are_closed():
+    assert "openwam" in codec_names()
+    with pytest.raises(ContractViolation, match="rot6d"):
+        OpenWAMCodec(IOSchema.from_descriptor(dual_arm_descriptor(), arm_format=ArmFormat.JOINT))
