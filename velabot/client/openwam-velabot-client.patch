new file mode 100644
index 00000000..42ca022b
--- /dev/null
+++ b/packages/velabot-runtime/tests/test_openwam_runtime.py
@@ -0,0 +1,37 @@
+"""Runtime composition selects the fixed OpenWAM schema and codec."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from velabot.app_runtime.policy_compose import codec_for, schema_for
+from velabot.apps.edge.main import _codec_for
+from velabot.contracts.errors import ContractViolation
+from velabot.hardware.profiles import load_descriptor
+
+PROFILE = Path(__file__).parents[3] / "profiles/robots/agilex-nero-dual-arm.yaml"
+
+
+def test_openwam_schema_and_codec_use_the_verified_profile_contract():
+    descriptor = load_descriptor(PROFILE)
+    schema = schema_for(descriptor=descriptor, protocol="openwam")
+    assert schema.action_dim == 20
+    assert schema.group_names == ("left_arm", "right_arm")
+    assert schema.include_base is False
+    assert codec_for("openwam", schema, descriptor).name == "openwam"
+    assert _codec_for("openwam", schema, descriptor).name == "openwam"
+
+
+@pytest.mark.parametrize(
+    "kwargs, message",
+    [
+        ({"arm_format": "joint"}, "arm-format"),
+        ({"include_base": True}, "base block"),
+    ],
+)
+def test_openwam_schema_rejects_non_mooncake_layout(kwargs, message):
+    descriptor = load_descriptor(PROFILE)
+    with pytest.raises(ContractViolation, match=message):
+        schema_for(descriptor=descriptor, protocol="openwam", **kwargs)
